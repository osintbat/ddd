{
  "name": "brokebase-promo",
  "private": true,
  "version": "1.0.0",
  "description": "Promo video for brokebase.com (1920x1080, 60 fps) built in Remotion with filled SVG icons",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "audio": "node scripts/soundtrack.mjs",
    "studio": "remotion studio",
    "render": "npm run audio && remotion render BrokebasePromo out/brokebase-promo.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@remotion/cli": "^4.0.531",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.531"
  },
  "devDependencies": {
    "@iconify-json/reicon": "^1.2.5",
    "@iconify-json/solar": "^1.2.13",
    "@remotion/bundler": "^4.0.531",
    "@remotion/renderer": "^4.0.531",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "simple-icons": "^16.33.0",
    "typescript": "^7.0.2"
  }
}
